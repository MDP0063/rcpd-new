# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio or Render automatically injects this at runtime.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional base URL for backend API calls.
# Leave empty ("") when running as a unified full-stack service on Render.com (recommended).
# Set to your Render service URL (e.g. "https://ca-post-officer-portal.onrender.com") only if hosting the frontend separately.
VITE_API_BASE_URL=""

# SESSION_SECRET: Geheimer Schlüssel (mind. 32 Zeichen) zum Signieren der Login-Sitzungen.
# Zufälligen Wert erzeugen, z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Fehlt er, wird bei jedem Neustart ein neuer erzeugt und alle Nutzer werden abgemeldet.
SESSION_SECRET=""

# ADMIN_INITIAL_PASSWORD: Passwort für das Konto "Admin1", wenn noch keine Datenbank existiert (mind. 8 Zeichen).
# Fehlt es, wird ein Zufallswert erzeugt und einmalig im Server-Log ausgegeben.
ADMIN_INITIAL_PASSWORD=""

# ALLOWED_ORIGINS: Kommagetrennte Liste von Webseiten, die die API aus dem Browser aufrufen dürfen.
# Leer lassen, wenn Frontend und Server unter derselben Adresse laufen (empfohlen).
ALLOWED_ORIGINS=""

# WHITELIST_API_KEY: Schlüssel für Server, die /api/v1/whitelist/verify ohne Login abfragen (z. B. Roblox-Anbindung).
# Wird als Header "X-Api-Key" gesendet. Leer = Abfrage nur mit Login möglich.
WHITELIST_API_KEY=""

# DATA_DIR: Ordner für die Datenbank-Datei (portal-db-v3.json). Auf Render muss er auf einem
# Persistent Disk liegen (z. B. /var/data), sonst gehen Daten bei jedem Deploy verloren.
DATA_DIR=""
