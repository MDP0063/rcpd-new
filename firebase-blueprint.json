{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Publicly accessible officer roster profile and RBAC clearance",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "badgeNumber": { "type": "string", "minLength": 2, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "callsign": { "type": "string", "minLength": 2, "maxLength": 20 },
        "rank": { "type": "string", "minLength": 2, "maxLength": 50 },
        "role": { "type": "string", "enum": ["applicant", "cadet", "officer", "fto", "supervisor", "admin"] },
        "clearanceLevel": { "type": "number" },
        "division": { "type": "string", "minLength": 2, "maxLength": 60 },
        "whitelistStatus": { "type": "string", "enum": ["pending", "probation", "whitelisted", "suspended", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "badgeNumber", "callsign", "rank", "role", "clearanceLevel", "division", "whitelistStatus", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII and account identifiers isolated from public roster",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "discordTag": { "type": "string", "minLength": 2, "maxLength": 64 },
        "steamHex": { "type": "string", "minLength": 2, "maxLength": 64 },
        "supervisorNotes": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "discordTag", "steamHex", "supervisorNotes", "updatedAt"]
    },
    "WhitelistApplication": {
      "title": "WhitelistApplication",
      "description": "Candidate application for California Police Roleplay Whitelist and Academy entry",
      "type": "object",
      "properties": {
        "applicantUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "characterName": { "type": "string", "minLength": 3, "maxLength": 80 },
        "dateOfBirth": { "type": "string", "minLength": 4, "maxLength": 20 },
        "discordTag": { "type": "string", "minLength": 2, "maxLength": 64 },
        "priorExperience": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "scenarioResponse": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "penalCodeAck": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "under_review", "interview_scheduled", "accepted", "rejected"] },
        "reviewerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "reviewerFeedback": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicantUid", "applicantName", "characterName", "dateOfBirth", "discordTag", "priorExperience", "scenarioResponse", "penalCodeAck", "status", "reviewerUid", "reviewerFeedback", "createdAt", "updatedAt"]
    },
    "TrainingModule": {
      "title": "TrainingModule",
      "description": "Academy SOP document, external embed, or interactive code simulation module",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "code": { "type": "string", "minLength": 2, "maxLength": 30 },
        "category": { "type": "string", "enum": ["SOP & Policy", "California Penal Code", "Tactical Operations", "Radio & Dispatch", "Field Training (FTO)", "Supervisor Directive"] },
        "minClearance": { "type": "number" },
        "requiredRole": { "type": "string", "enum": ["applicant", "cadet", "officer", "fto", "supervisor", "admin"] },
        "embedType": { "type": "string", "enum": ["document", "external_url", "interactive_code"] },
        "contentMarkdown": { "type": "string", "minLength": 1, "maxLength": 15000 },
        "externalUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "interactiveCode": { "type": "string", "minLength": 0, "maxLength": 15000 },
        "estimatedMinutes": { "type": "number" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "code", "category", "minClearance", "requiredRole", "embedType", "contentMarkdown", "externalUrl", "interactiveCode", "estimatedMinutes", "authorUid", "createdAt", "updatedAt"]
    },
    "AcademyExam": {
      "title": "AcademyExam",
      "description": "Interactive examination or tactical code evaluation tied to a clearance level",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "moduleCode": { "type": "string", "minLength": 2, "maxLength": 30 },
        "minClearance": { "type": "number" },
        "passingScore": { "type": "number" },
        "timeLimitMinutes": { "type": "number" },
        "examFormat": { "type": "string", "enum": ["structured_quiz", "interactive_widget", "external_assessment"] },
        "questionsPayload": { "type": "string", "minLength": 2, "maxLength": 15000 },
        "interactiveWidgetCode": { "type": "string", "minLength": 0, "maxLength": 15000 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "moduleCode", "minClearance", "passingScore", "timeLimitMinutes", "examFormat", "questionsPayload", "interactiveWidgetCode", "authorUid", "createdAt", "updatedAt"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Individual officer learning progress and exam certification record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["module", "exam"] },
        "targetTitle": { "type": "string", "minLength": 2, "maxLength": 140 },
        "status": { "type": "string", "enum": ["in_progress", "completed", "passed", "failed"] },
        "scorePercent": { "type": "number" },
        "attempts": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "targetId", "targetType", "targetTitle", "status", "scorePercent", "attempts", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public officer roster profiles and clearance level metadata"
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Strict PII isolation for officer email, Discord, SteamHex, and internal notes"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/WhitelistApplication" },
      "description": "Whitelist and police academy applications"
    },
    "/training_modules/{moduleId}": {
      "schema": { "$ref": "#/entities/TrainingModule" },
      "description": "Role-gated police training materials, external documents, and interactive code embeds"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/AcademyExam" },
      "description": "Interactive evaluations and certification exams"
    },
    "/user_progress/{progressId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Per-user learning and exam completion tracking"
    }
  }
}
